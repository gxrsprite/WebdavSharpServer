{
  "Dav": {
    "Address": "0.0.0.0",
    "Port": 5210,
    "Prefix": "/dav/",
    "Directory": "LocalPaths/dav-root",
    "DefaultPermissions": "R",
    "BehindProxy": false,
    "Cors": {
      "Enabled": true,
      "Credentials": true,
      "AllowedHosts": ["*"]
    },
    "Database": "Sqlite",
    "ConnectionString": "Data Source=LocalPaths/webdavsharp.db",
    "AutoSyncStructure": true,
    "FtpEnabled": false,
    "FtpPort": 2121,
    "Seed": {
      "AdminUsername": "admin",
      "AdminPassword": "admin"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
