{
  "Dav": {
    "AutoSyncStructure": true,
    // CX 等客户端需要 SMB1（RAP 枚举只存在于 SMB1）；SMB2/SMB3 默认即开启，
    // 开发联调三个方言全开，生产环境建议关闭 SMB1。
    "SmbEnableSmb1": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "WebdavSharp": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "FreeSql": "Warning"
      }
    }
  }
}
